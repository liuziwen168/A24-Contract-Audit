APP_ENV=development
# Local MySQL database used by backend and Alembic; never commit credentials.
DATABASE_URL=mysql+pymysql://<DB_USER>:<DB_PASSWORD>@localhost:3306/a24_dev_integration?charset=utf8mb4
JWT_SECRET=<CHANGE_ME>
JWT_EXPIRE_SECONDS=3600
AI_SERVICE_BASE_URL=http://localhost:8001/internal/v1
AI_INTERNAL_TOKEN=<CHANGE_ME>
TASK_EXECUTOR_ENABLED=false
TASK_POLL_SECONDS=1
TASK_STALE_SECONDS=300
AI_RETRY_COUNT=2
AI_RETRY_BASE_SECONDS=1
UPLOAD_ROOT=./storage/uploads
REPORT_ROOT=./storage/reports
REPORT_EXECUTOR_ENABLED=false
REPORT_TASK_POLL_SECONDS=1
REPORT_TASK_STALE_SECONDS=300
REPORT_MAX_ATTEMPTS=3
MAX_UPLOAD_MB=20
# Comma-separated browser origins; do not use '*' with credentialed requests.
CORS_ORIGINS=http://localhost:5173
TRUSTED_HOSTS=localhost,127.0.0.1
OPENAPI_ENABLED=true
DEMO_USER_PASSWORD=<CHANGE_ME>
DEMO_LEGAL_REVIEWER_PASSWORD=<CHANGE_ME>
DEMO_RISK_REVIEWER_PASSWORD=<CHANGE_ME>
DEMO_ADMIN_PASSWORD=<CHANGE_ME>
